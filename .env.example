# Clé OpenRouter (https://openrouter.ai/keys). Ne jamais la committer.
OPENROUTER_API_KEY=

# Modèle utilisé par l'assistant (identifiant OpenRouter).
# Options : anthropic/claude-opus-5.5 (défaut), anthropic/claude-sonnet-5.5, anthropic/claude-haiku-5.5
AI_MODEL=anthropic/claude-opus-5.5

# Point d'entrée compatible API Claude d'OpenRouter (le SDK ajoute /v1/messages).
AI_BASE_URL=https://openrouter.ai/api

# Nombre maximum de demandes à l'assistant par espace et par jour.
AI_DAILY_LIMIT=200

# Facultatif : identifie l'app dans le tableau de bord OpenRouter.
APP_URL=http://localhost:3000
