# Clé OpenRouter (https://openrouter.ai/keys). Ne jamais la committer.
# Facultatif : la clé peut aussi être saisie dans l'application (page Paramètres), où elle est chiffrée.
# Une clé saisie dans Paramètres a priorité sur celle-ci.
OPENROUTER_API_KEY=

# Secret servant à chiffrer la clé saisie dans Paramètres (AES-256-GCM). Obligatoire en production.
# Générer avec : openssl rand -base64 32. Le perdre ou le changer rend la clé enregistrée illisible
# (il suffit alors de la ressaisir dans Paramètres).
APP_SECRET=

# Modèle par défaut (identifiant OpenRouter), si aucun n'est choisi dans Paramètres.
# Options : anthropic/claude-opus-5.5 (défaut), anthropic/claude-sonnet-5.5, anthropic/claude-haiku-5.5
AI_MODEL=anthropic/claude-opus-5.5

# Point d'entrée compatible API Claude d'OpenRouter (le SDK ajoute /v1/messages).
AI_BASE_URL=https://openrouter.ai/api

# Limite par défaut de demandes à l'IA par organisation et par jour, si aucune n'est fixée dans Paramètres.
AI_DAILY_LIMIT=200

# Facultatif : identifie l'app dans le tableau de bord OpenRouter.
APP_URL=http://localhost:3000

# --- Base de données ---
# Développement : laisser DATABASE_URL vide → PostgreSQL embarqué (PGlite) dans ./.data/pglite.
# Production (VPS, docker-compose) : DATABASE_URL est construit par docker-compose à partir de POSTGRES_PASSWORD.
DATABASE_URL=
POSTGRES_PASSWORD=
# 1 pour charger les données de démonstration en production (phase de prototype).
SEED_DEMO=0
